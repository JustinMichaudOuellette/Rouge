*.iml
.gradle
/local.properties
.idea/*
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
.kotlin/*
app/release/*
# tools/release.py writes one optimized APK per --min-sdks level:
# rouge_final-min37.apk, rouge_final-min34.apk, or rouge_final.apk for a
# single level.
/rouge_final*.apk
.reasonix/*
reasonix.toml
tools/__pycache__/*

# The signing identity: never commit the keystore or its password, wherever
# they are put. The matching <keystore>.sha256 fingerprint file is public --
# it is what the Play Console asks for -- and is meant to be committed.
*.p12
*.p12.pass
*.jks
*.jks.pass
*.keystore
